# Entorno virtual
.venv/

# Vídeos y audio (grandes, no van al repo)
*.mp4
*.MP4
*.mov
*.MOV
*.avi
*.AVI
*.mkv
*.MKV
*.wav

# Carpetas de trabajo (se crean automáticamente al ejecutar)
entrada/
salida/

# Archivos temporales del script
_audio_tmp.wav
_check_inicio.wav
_check_fin.wav

# Historial dinámico de duraciones de vuelo (se va aprendiendo de cada parque)
historial_vuelos.json

# Configuración y credenciales del envío por correo (NUNCA al repo)
config_sheets.json
*service_account*.json
*credentials*.json
*.json.key
# Clave de la cuenta de servicio de Google (nombre que genera Google Cloud)
sunviewparkvideos-*.json

# Cache de Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Claude Code (configuración local del asistente)
.claude/

# ffmpeg portátil descomprimido dentro de la app (cada PC descarga el suyo)
ffmpeg/

# Notas y capturas locales de prueba (no van al repo)
codigo_revision.txt
fotos prueba/
/*.png

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini
